# PostgreSQL connection string used by Prisma.
# If this is left unset, WebhookLab falls back to an in-memory store
# (see README "Demo mode") so the app and the test suite still run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webhooklab?schema=public"

# Shared secret used to verify the `x-webhook-signature` header (HMAC-SHA256).
# Leave empty to accept unsigned webhooks (useful for local simulation).
WEBHOOK_SIGNING_SECRET="whsec_dev_secret"

# Number of attempts (initial delivery + retries) before an event is left as FAILED.
WEBHOOK_MAX_ATTEMPTS="3"